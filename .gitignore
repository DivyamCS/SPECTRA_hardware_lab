host/runs/
host/runs_*/
__pycache__/
*.pyc
sim/rv32sim
sim/rv32sim.exe
sim/rv32sim.pdb
# Vivado / xsim outputs (run directories live in build/<commit>/, never committed;
# released bitstreams and reports go in build/releases/, which is committed)
build/*
!build/releases/
.Xil/
xsim.dir/
*.jou
vivado*.log
vivado_pid*.str
webtalk*
*.wdb
*.pb
dfx_runtime.txt
# ELFs embed a random temporary object name, so they change on every build; the
# hex files and listings are the tracked build outputs
fw/build/*/*.elf
tb/lab5a/image/*.elf
backups/
# reference traces and streams: regenerated by tools/make_refs.py (the commit-trace test needs them)
tb/ref/
# D-cache vectors: the random test writes its own into its run folder
tb/vectors/dcache_*.mem
